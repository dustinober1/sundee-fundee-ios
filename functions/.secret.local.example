# Firebase Cloud Functions — Local Emulator Secrets
# Copy this file to .secret.local and fill in your values.
# .secret.local is gitignored — never commit real secrets.
#
# For local development with the Firebase Emulator Suite:
#   1. Copy: cp .secret.local.example .secret.local
#   2. Fill in your test credentials below
#   3. Run: firebase emulators:start --only functions
#
# For production deployment, set secrets via Cloud Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

GEMINI_API_KEY=AIza_your_gemini_api_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
