{
  "name": "sundee-fundee-functions",
  "description": "Firebase Cloud Functions for Sundee Fundee",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "~5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/src/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "moduleNameMapper": {
      "firebase-functions/v2/https": "<rootDir>/__mocks__/firebase-functions.ts",
      "firebase-functions/params": "<rootDir>/__mocks__/firebase-functions-params.ts",
      "firebase-admin/firestore": "<rootDir>/__mocks__/firebase-admin-firestore.ts",
      "firebase-admin/app": "<rootDir>/__mocks__/firebase-admin.ts",
      "firebase-admin": "<rootDir>/__mocks__/firebase-admin.ts",
      "@google/genai": "<rootDir>/__mocks__/generative-ai.ts",
      "^stripe$": "<rootDir>/__mocks__/stripe.ts",
      "firebase-functions/logger": "<rootDir>/__mocks__/firebase-functions-logger.ts"
    }
  },
  "private": true
}
