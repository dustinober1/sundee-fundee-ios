          1,
          4
        ]
      },
      {
        "id": "strength-intensification",
        "name": "Strength Intensification",
        "goal": "Increase intensity and decrease volume to peak strength capacity (85-95% 1RM).",
        "weekRange": [
          5,
          7
        ]
      },
      {
        "id": "deload-testing",
        "name": "Deload & Testing",
