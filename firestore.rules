rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all reads and writes.
    // No document is accessible unless an explicit rule below grants access.
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile: only the owning authenticated user can read or write.
    // This includes the user document itself (/users/{uid}).
    //
    // SEC-01: Per-user ownership enforcement — prevents cross-user data access.
    // SEC-02: premiumEntitlement field block — prevents client-side subscription escalation.
    //         The premiumEntitlement field is ONLY written by the stripeWebhook Cloud Function
    //         via Firebase Admin SDK (which bypasses security rules). Client SDK cannot write it.
    match /users/{userId} {
      // Owner can always read their own profile.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Owner can create their own profile, but cannot include premiumEntitlement.
      // On create, resource.data does not yet exist, so we check request.resource.data directly.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !('premiumEntitlement' in request.resource.data);

      // Owner can update their own profile, but cannot touch the premiumEntitlement field.
      // diff().affectedKeys().hasAny() detects if premiumEntitlement was added, changed, or removed.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                       .affectedKeys().hasAny(['premiumEntitlement']);

      // Owner can delete their own profile.
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Depth-1 subcollections (workouts, injuries, periodLogs, cycleSettings, readiness,
      // benchmarkResults, customBenchmarks, exerciseMaxes, exercises, programs, onboardingProfile,
      // settings, rateLimits, etc.):
      // Owner-only access. No cross-user data access permitted.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Depth-2 subcollections (e.g., injuries/{id}/painLogs/{id}):
      // Owner-only access. The {nested=**} wildcard matches all paths at depth 2 and beyond.
      // Without this rule, injuries/{id}/painLogs/{id} would be denied by the default-deny rule.
      match /{subcollection}/{docId}/{nested=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Programs collection: authenticated users can read program data.
    // No client writes — programs are admin-seeded via Firebase Console or Cloud Functions.
    // Anonymous (guest) users with a Firebase auth token CAN read programs.
    match /programs/{programId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // WODs collection: authenticated users can read WOD data.
    // No client writes — WODs are admin-seeded via Firebase Console or Cloud Functions.
    match /wods/{wodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
