rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validInjuryProfile(injury) {
      return injury is map
        && (!('id' in injury) || injury.id is string)
        && (!('location' in injury) || injury.location is string)
        && (!('movementLimitations' in injury) || injury.movementLimitations is string)
        && (!('recoveryGoal' in injury) || injury.recoveryGoal is string)
        && (!('status' in injury) || injury.status in ['active', 'resolved'])
        && (!('createdAt' in injury) || injury.createdAt is timestamp || injury.createdAt is string)
        && (!('updatedAt' in injury) || injury.updatedAt is timestamp || injury.updatedAt is string)
        && (!('resolvedAt' in injury) || injury.resolvedAt is timestamp || injury.resolvedAt is string || injury.resolvedAt == null);
    }

    function validUserProfileWrite(userId) {
      let data = request.resource.data;
      let injuries = data.injuryProfiles;
      return data.id == userId
        && (!('onboardingComplete' in data) || data.onboardingComplete is bool)
        && (!('profileUpdatedAt' in data) || data.profileUpdatedAt is timestamp || data.profileUpdatedAt is string)
        && (!('injuryProfiles' in data) || (injuries is list && injuries.size() <= 20));
    }

    function validEnrollmentStatus(status) {
      return status in ['active', 'canceled', 'completed'];
    }

    function validEnrollmentWrite(enrollment, enrollmentId) {
      return enrollment.id == enrollmentId
        && enrollment.programId is string
        && (enrollment.startDate is timestamp || enrollment.startDate is string)
        && enrollment.currentWeek is int
        && enrollment.currentDay is int
        && (!('isActive' in enrollment) || enrollment.isActive is bool)
        && (!('status' in enrollment) || validEnrollmentStatus(enrollment.status))
        && (!('completedAt' in enrollment) || enrollment.completedAt is timestamp || enrollment.completedAt is string || enrollment.completedAt == null)
        && (!('canceledAt' in enrollment) || enrollment.canceledAt is timestamp || enrollment.canceledAt is string || enrollment.canceledAt == null)
        && (!('lastSyncedAt' in enrollment) || enrollment.lastSyncedAt is timestamp || enrollment.lastSyncedAt is string || enrollment.lastSyncedAt == null)
        && (!('completedWeeks' in enrollment) || enrollment.completedWeeks is list);
    }

    function validEnrollmentEventType(eventType) {
      return eventType in ['enrolled', 'canceled', 'completed', 'restored', 'auto_healed'];
    }

    function validEnrollmentEventWrite(event, eventId) {
      return event.id == eventId
        && event.enrollmentId is string
        && validEnrollmentEventType(event.eventType)
        && (event.occurredAt is timestamp || event.occurredAt is string)
        && (!('programId' in event) || event.programId is string || event.programId == null)
        && (!('metadata' in event) || event.metadata is map);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserProfileWrite(userId);
      allow delete: if isOwner(userId);

      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }

      match /completedSets/{setId} {
        allow read, write: if isOwner(userId);
      }

      match /maxLifts/{liftId} {
        allow read, write: if isOwner(userId);
      }

      match /oneRepMaxes/{ormId} {
        allow read, write: if isOwner(userId);
      }

      match /records/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /cycles/{cycleDoc=**} {
        allow read, write: if isOwner(userId);
      }

      match /customPrograms/{programDoc=**} {
        allow read, write: if isOwner(userId);
      }

      match /periodLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /symptomLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingsId} {
        allow read, write: if isOwner(userId);
      }

      match /enrollments/{enrollmentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validEnrollmentWrite(request.resource.data, enrollmentId);
        allow delete: if isOwner(userId);
      }

      match /enrollmentEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validEnrollmentEventWrite(request.resource.data, eventId);
        allow delete: if isOwner(userId);
      }
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if false;
    }

    match /programCatalog/{programId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
