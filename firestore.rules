rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all reads and writes.
    // No document is accessible unless an explicit rule below grants access.
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile: only the owning authenticated user can read or write.
    // This includes the user document itself (/users/{uid}).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // All user subcollections (workouts, injuries, cycle logs, benchmarks, etc.):
      // Owner-only access. No cross-user data access permitted.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 2-level nested subcollection: pain logs under an injury profile
      match /injuries/{injuryId}/painLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Programs collection: authenticated users can read program data.
    // No client writes — programs are admin-seeded via Firebase Console or Cloud Functions.
    // Anonymous (guest) users with a Firebase auth token CAN read programs.
    match /programs/{programId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // WODs collection: authenticated users can read WOD data.
    // No client writes — WODs are admin-seeded via Firebase Console or Cloud Functions.
    match /wods/{wodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
