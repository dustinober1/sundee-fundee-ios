rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }

      match /completedSets/{setId} {
        allow read, write: if isOwner(userId);
      }

      match /maxLifts/{liftId} {
        allow read, write: if isOwner(userId);
      }

      match /oneRepMaxes/{ormId} {
        allow read, write: if isOwner(userId);
      }

      match /records/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /cycles/{cycleDoc=**} {
        allow read, write: if isOwner(userId);
      }

      match /customPrograms/{programDoc=**} {
        allow read, write: if isOwner(userId);
      }

      match /periodLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /symptomLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/cycle {
        allow read, write: if isOwner(userId);
      }

      match /enrollments/{enrollmentId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /programCatalog/{programId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
