# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

require "snapshot/test_command_generator"

# Xcode 26.4.1 reports Simulator runtimes with the patch version, while
# fastlane 2.233.1's DeviceManager truncates them to 26.4. Use UDID
# destinations so snapshot does not generate an unresolvable OS selector.
module ::Snapshot
  class TestCommandGenerator < TestCommandGeneratorBase
    class << self
      def destination(devices)
        destinations = devices.map do |device_name|
          device = find_device(device_name, Snapshot.config[:ios_version])
          UI.user_error!("No simulator found named '#{device_name}'") if device.nil?

          "-destination 'platform=iOS Simulator,id=#{device.udid}'"
        end

        [destinations.join(" ")]
      end
    end
  end
end

platform :ios do
  private_lane :load_asc_api_key do
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    key_path = ENV["ASC_PRIVATE_KEY_PATH"]
    key_content = ENV["ASC_PRIVATE_KEY"]

    if key_id.to_s.empty? || issuer_id.to_s.empty? || (key_path.to_s.empty? && key_content.to_s.empty?)
      nil
    else

      options = {
        key_id: key_id,
        issuer_id: issuer_id,
        duration: 1200,
        in_house: false
      }

      if key_path.to_s.empty?
        options[:key_content] = key_content
      else
        options[:key_filepath] = key_path
      end

      app_store_connect_api_key(**options)
    end
  end

  private_lane :capture_store_screenshots do
    capture_ios_screenshots(
      project: "SundeeFundee.xcodeproj",
      scheme: "SundeeFundee",
      devices: ["iPhone 17 Pro", "iPhone 11 Pro Max", "iPad Pro 13-inch (M5)"],
      ios_version: "26.5",
      languages: ["en-US"],
      launch_arguments: ["--seed-screenshots"],
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      reinstall_app: true,
      skip_open_summary: true,
      override_status_bar: true,
      configuration: "Debug",
      clean: true,
      skip_helper_version_check: true,
      number_of_retries: 0,
      concurrent_simulators: false,
      only_testing: ["SundeeFundeeUITests/SundeeFundeeScreenshotTests/testAppStoreScreenshots"],
      stop_after_first_error: true
    )
  end

  desc "Capture fresh App Store screenshots"
  lane :screenshots do
    capture_store_screenshots
  end

  desc "Push a new release build to the App Store"
  lane :release do
    api_key = load_asc_api_key

    build_app(
      scheme: "SundeeFundee",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "87VVCMCW3F"
      },
      xcargs: "-allowProvisioningUpdates"
    )
    upload_to_app_store(
      api_key: api_key,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      },
      precheck_include_in_app_purchases: false
    )
  end

  desc "Add missing screenshots to the already-uploaded build and submit for review, without rebuilding or touching existing screenshots"
  lane :submit_screenshots_only do
    api_key = load_asc_api_key

    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      },
      precheck_include_in_app_purchases: false
    )
  end
end
