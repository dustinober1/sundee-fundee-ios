    {
      "id": "phase-1",
      "name": "Hypertrophy & Positional Foundation",
      "goal": "Build muscle and master the upright torso",
      "weekRange": [1, 4]
    },
    {
      "id": "phase-2",
      "name": "Strength & Rigidity",
      "goal": "Increase intensity and anti-folding strength",
      "weekRange": [5, 7]
    },
    {
      "id": "phase-3",
      "name": "Peak & Test",
      "goal": "Dissipate fatigue and set new 1RM",
      "weekRange": [8, 8]
    }
  ],
